# ============================================================
# Portfolio Manager — full stack via Docker Compose
# Place at project ROOT, alongside pom.xml and the /frontend folder.
#
# Run with:  docker compose up --build
# ============================================================

services:

  mysql:
    image: mysql:8.0
    container_name: portfolio-mysql
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: ${DB_NAME:-portfolio_manager}
      MYSQL_ROOT_PASSWORD: ${DB_PASSWORD}
    ports:
      - "3306:3306"
    volumes:
      # Named volume — MySQL data survives `docker compose down`, so restarting
      # the stack doesn't wipe your imported price history / holdings every time.
      - mysql_data:/var/lib/mysql
    healthcheck:
      # Backend must not start until MySQL is actually ready to accept
      # connections — starting both at once causes Flyway to fail on a
      # connection refused, which is the classic "works after a restart,
      # fails on first `docker compose up`" bug.
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-uroot", "-p${DB_PASSWORD}"]
      interval: 5s
      timeout: 5s
      retries: 10

  backend:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: portfolio-backend
    restart: unless-stopped
    depends_on:
      mysql:
        condition: service_healthy
    environment:
      DB_HOST: mysql
      DB_PORT: 3306
      DB_NAME: ${DB_NAME:-portfolio_manager}
      DB_USERNAME: root
      DB_PASSWORD: ${DB_PASSWORD}
    ports:
      - "8080:8080"

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
      args:
        VITE_API_BASE_URL: ${VITE_API_BASE_URL:-http://localhost:8080}
    container_name: portfolio-frontend
    restart: unless-stopped
    depends_on:
      - backend
    ports:
      - "5173:80"

volumes:
  mysql_data: